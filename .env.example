# ============================================================
# Skorify Frontend — Variables de entorno
# ============================================================
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
#
# NUNCA subas .env.local ni ningún archivo con valores reales
# al repositorio. Solo .env.example se commitea.
# ============================================================

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
# URL base del backend de Skorify. Incluye el protocolo y,
# si corresponde, el path base (ej. /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# URL pública del frontend. Se usa para generar links de
# invitación y como base del redirect_uri de Cognito Hosted UI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# AWS Cognito
# ------------------------------------------------------------
# User Pool ID en formato <region>_<id> (visible en la consola
# de Cognito, p. ej. us-east-1_ABC123def).
NEXT_PUBLIC_USER_POOL_ID=

# App Client ID del User Pool. Debe ser un client público
# (sin secret) con USER_SRP_AUTH habilitado y, si vas a usar
# Google, también Hosted UI con identity provider Google.
NEXT_PUBLIC_CLIENT_ID=

# Dominio del Hosted UI de Cognito (sin protocolo).
# Requerido solo para iniciar sesión con Google.
# Ejemplo: skorify.auth.us-east-1.amazoncognito.com
# Configura como callback en Cognito:
#   ${NEXT_PUBLIC_APP_URL}/auth/callback
NEXT_PUBLIC_COGNITO_DOMAIN=
